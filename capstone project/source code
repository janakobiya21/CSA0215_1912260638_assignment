int main(void) {
    int choice;
    loadSampleBooks();

    do {
        printf("\n========== LIBRARY BOOK TRACKING SYSTEM ==========\n");
        printf("1. Add Book\n");
        printf("2. Display All Books\n");
        printf("3. Search Book\n");
        printf("4. Issue Book\n");
        printf("5. Return Book (with Fine)\n");
        printf("6. Quick Fine Calculator\n");
        printf("7. Total Fine Collected\n");
        printf("0. Exit\n");
        printf("Enter your choice: ");
        if (scanf("%d", &choice) != 1) {
            clearInput();
            choice = -1;
        } else {
            clearInput();
        }

        switch (choice) {
            case 1: addBook(); break;
            case 2: displayBooks(); break;
            case 3: searchBook(); break;
            case 4: issueBook(); break;
            case 5: returnBook(); break;
            case 6: fineCalculator(); break;
            case 7: printf("Total fine collected: Rs. %d\n", totalFineCollected); break;
            case 0: printf("Thank you for using the Library System!\n"); break;
            default: printf("Invalid choice. Try again.\n");
        }
    } while (choice != 0);

    return 0;
}
