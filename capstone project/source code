#include <stdio.h>
#include <string.h>

#define MAX_BOOKS 100
#define LOW_RATE 2      /* Rs. per day for 1-5 overdue days   */
#define HIGH_RATE 5     /* Rs. per day for more than 5 days   */
#define LOW_LIMIT 5     /* days charged at the low rate       */

struct Date {
    int d, m, y;
};

struct Book {
    int id;
    char title[100];
    char author[60];
    int isIssued;               /* 0 = Available, 1 = Issued */
    char borrower[60];
    struct Date issueDate;
    struct Date dueDate;
};

struct Book library[MAX_BOOKS];
int bookCount = 0;
int totalFineCollected = 0;

/* ---------- Helper functions ---------- */

void clearInput(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) { }
}

void readLine(char *buf, int size) {
    if (fgets(buf, size, stdin) != NULL) {
        buf[strcspn(buf, "\n")] = '\0';
    }
}

int isLeapYear(int y) {
    return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
}

int isValidDate(struct Date dt) {
    int daysInMonth[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    if (dt.y < 1900 || dt.m < 1 || dt.m > 12 || dt.d < 1) return 0;
    if (dt.m == 2 && isLeapYear(dt.y)) return dt.d <= 29;
    return dt.d <= daysInMonth[dt.m - 1];
}

/* Converts a date into a day number so two dates can be subtracted. */
long dateToDays(struct Date dt) {
    int y = dt.y, m = dt.m;
    if (m < 3) {
        y--;
        m += 12;
    }
    return 365L * y + y / 4 - y / 100 + y / 400 + (153 * (m - 3) + 2) / 5 + dt.d - 1;
}

int readDate(const char *label, struct Date *dt) {
    printf("%s (DD/MM/YYYY): ", label);
    if (scanf("%d/%d/%d", &dt->d, &dt->m, &dt->y) != 3 || !isValidDate(*dt)) {
        clearInput();
        printf("  Invalid date.\n");
        return 0;
    }
    clearInput();
    return 1;
}

int findBook(int id) {
    int i;
    for (i = 0; i < bookCount; i++) {
        if (library[i].id == id) return i;
    }
    return -1;
}

/* ---------- Module 1: Book Management ---------- */

void addBook(void) {
    struct Book b;
    if (bookCount >= MAX_BOOKS) {
        printf("Library is full.\n");
        return;
    }
    printf("Enter Book ID: ");
    if (scanf("%d", &b.id) != 1) {
        clearInput();
        printf("Invalid ID.\n");
        return;
    }
    clearInput();
    if (findBook(b.id) != -1) {
        printf("A book with ID %d already exists.\n", b.id);
        return;
    }
    printf("Enter Title: ");
    readLine(b.title, sizeof(b.title));
    printf("Enter Author: ");
    readLine(b.author, sizeof(b.author));
    b.isIssued = 0;
    b.borrower[0] = '\0';
    library[bookCount++] = b;
    printf("Book added successfully.\n");
}

void displayBooks(void) {
    int i;
    if (bookCount == 0) {
        printf("No books in the library.\n");
        return;
    }
    printf("\n%-6s %-32s %-22s %-10s %-12s\n", "ID", "Title", "Author", "Status", "Due Date");
    printf("------------------------------------------------------------------------------------\n");
    for (i = 0; i < bookCount; i++) {
        printf("%-6d %-32.32s %-22.22s %-10s ", library[i].id, library[i].title,
               library[i].author, library[i].isIssued ? "Issued" : "Available");
        if (library[i].isIssued) {
            printf("%02d/%02d/%04d", library[i].dueDate.d, library[i].dueDate.m, library[i].dueDate.y);
        } else {
            printf("-");
        }
        printf("\n");
    }
}

void searchBook(void) {
    int id, idx;
    printf("Enter Book ID to search: ");
    if (scanf("%d", &id) != 1) {
        clearInput();
        printf("Invalid ID.\n");
        return;
    }
    clearInput();
    idx = findBook(id);
    if (idx == -1) {
        printf("Book not found.\n");
        return;
    }
    printf("\nID       : %d\n", library[idx].id);
    printf("Title    : %s\n", library[idx].title);
    printf("Author   : %s\n", library[idx].author);
    printf("Status   : %s\n", library[idx].isIssued ? "Issued" : "Available");
    if (library[idx].isIssued) {
        printf("Borrower : %s\n", library[idx].borrower);
        printf("Due Date : %02d/%02d/%04d\n", library[idx].dueDate.d,
               library[idx].dueDate.m, library[idx].dueDate.y);
    }
}

/* ---------- Module 2: Issue Management ---------- */

void issueBook(void) {
    int id, idx;
    struct Date issue, due;
    printf("Enter Book ID to issue: ");
    if (scanf("%d", &id) != 1) {
        clearInput();
        printf("Invalid ID.\n");
        return;
    }
    clearInput();
    idx = findBook(id);
    if (idx == -1) {
        printf("Book not found.\n");
        return;
    }
    if (library[idx].isIssued) {
        printf("Sorry, this book is already issued to %s.\n", library[idx].borrower);
        return;
    }
    printf("Enter Borrower Name: ");
    readLine(library[idx].borrower, sizeof(library[idx].borrower));
    if (!readDate("Enter Issue Date", &issue)) return;
    if (!readDate("Enter Due Date", &due)) return;
    if (dateToDays(due) < dateToDays(issue)) {
        printf("Due date cannot be before the issue date.\n");
        return;
    }
    library[idx].issueDate = issue;
    library[idx].dueDate = due;
    library[idx].isIssued = 1;
    printf("Book \"%s\" issued to %s.\n", library[idx].title, library[idx].borrower);
}

/* ---------- Module 4: Fine Calculation ---------- */

int calculateFine(int overdueDays) {
    if (overdueDays <= 0) return 0;
    if (overdueDays <= LOW_LIMIT) return overdueDays * LOW_RATE;
    return overdueDays * HIGH_RATE;
}

/* ---------- Module 3: Return & Overdue Management ---------- */

int calculateOverdueDays(struct Date due, struct Date ret) {
    long diff = dateToDays(ret) - dateToDays(due);
    return diff > 0 ? (int)diff : 0;
}

void returnBook(void) {
    int id, idx, overdue, fine;
    struct Date ret;
    printf("Enter Book ID to return: ");
    if (scanf("%d", &id) != 1) {
        clearInput();
        printf("Invalid ID.\n");
        return;
    }
    clearInput();
    idx = findBook(id);
    if (idx == -1) {
        printf("Book not found.\n");
        return;
    }
    if (!library[idx].isIssued) {
        printf("This book is not issued.\n");
        return;
    }
    if (!readDate("Enter Return Date", &ret)) return;
    if (dateToDays(ret) < dateToDays(library[idx].issueDate)) {
        printf("Return date cannot be before the issue date.\n");
        return;
    }

    overdue = calculateOverdueDays(library[idx].dueDate, ret);
    fine = calculateFine(overdue);
    totalFineCollected += fine;

    printf("\n----------- RETURN RECEIPT -----------\n");
    printf("Book     : %s\n", library[idx].title);
    printf("Borrower : %s\n", library[idx].borrower);
    printf("Due Date : %02d/%02d/%04d\n", library[idx].dueDate.d,
           library[idx].dueDate.m, library[idx].dueDate.y);
    printf("Returned : %02d/%02d/%04d\n", ret.d, ret.m, ret.y);
    printf("Overdue  : %d day(s)\n", overdue);
    if (overdue > 0) {
        printf("Rate     : Rs. %d per day\n", overdue <= LOW_LIMIT ? LOW_RATE : HIGH_RATE);
    }
    printf("Fine     : Rs. %d\n", fine);
    printf("--------------------------------------\n");

    library[idx].isIssued = 0;
    library[idx].borrower[0] = '\0';
}

void fineCalculator(void) {
    struct Date due, ret;
    int overdue;
    printf("-- Quick Fine Calculator --\n");
    if (!readDate("Enter Due Date", &due)) return;
    if (!readDate("Enter Return Date", &ret)) return;
    overdue = calculateOverdueDays(due, ret);
    printf("Overdue days: %d\n", overdue);
    printf("Fine amount : Rs. %d\n", calculateFine(overdue));
}

